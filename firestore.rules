rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? userDoc().data.get('role', null)
        : null;
    }
    // Admin-portal staff (see STAFF_ROLES in web/src/App.jsx)
    // Payment fields are written only by the server after PayHere confirms a payment
    function paymentUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['paymentStatus', 'paidAmount', 'paidCurrency', 'paymentId', 'paymentMethod', 'paidAt']);
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'admin@ceylo.com') ||
        myRole() in ['admin', 'super_admin', 'manager', 'support', 'finance',
                     'vendor_manager', 'guide_manager', 'content_manager']
      );
    }
    function hasRole(role) {
      return isSignedIn() && myRole() == role;
    }
    function isDriver() {
      return hasRole('driver') || hasRole('driver_active');
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Roles a user may give themselves when signing up
    function isSelfServiceRole(role) {
      return role in ['tourist', 'guide_pending', 'driver_pending', 'vendor_onboarding'];
    }
    // Self-service role changes: submitting an application or re-applying after rejection.
    // Approval (guide, driver_active, vendor_active, admin, ...) is only ever set by staff.
    function isAllowedRoleChange() {
      let before = resource.data.get('role', null);
      let after = request.resource.data.get('role', null);
      return before == after
        || (before == null && isSelfServiceRole(after))
        || (before in ['vendor_onboarding', 'vendor_rejected'] && after == 'vendor_pending')
        || (before in ['guide_pending', 'guide_rejected'] && after == 'guide_pending')
        || (before == 'driver_rejected' && after == 'driver_pending');
    }

    // phoneVerified may only be claimed for the number Firebase verified at sign-in
    function phoneClaimOk() {
      return !('phoneVerified' in request.resource.data)
        || request.resource.data.phoneVerified != true
        || ('phone_number' in request.auth.token
            && request.resource.data.get('phone', null) == request.auth.token.phone_number);
    }

    // Users collection
    // Privacy: a traveller's profile (email, phone, preferences, consent) is readable only by
    // them and by staff. Guide, driver and business profiles are public listings.
    function isPublicProfile() {
      return resource.data.get('role', null) in ['guide', 'driver', 'driver_active', 'vendor',
                                                  'vendor_active', 'accommodation', 'tour_provider'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || (isSignedIn() && isPublicProfile());
      allow create: if isAdmin() || (
        isOwner(uid) &&
        (!('role' in request.resource.data) || isSelfServiceRole(request.resource.data.role)) &&
        !('isBanned' in request.resource.data) &&
        phoneClaimOk()
      );
      allow update: if isAdmin() || (
        isOwner(uid) &&
        isAllowedRoleChange() &&
        !changedKeys().hasAny(['isBanned', 'flagged']) &&
        phoneClaimOk() &&
        (!changedKeys().hasAny(['status']) || request.resource.data.status == 'pending_verification')
      );
      allow delete: if isAdmin();
    }

    // Push tokens, kept apart from profiles so booking partners can notify each other
    // without being able to read a traveller's profile
    match /push_tokens/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Bookings (guide tours and rides)
    match /bookings/{bookingId} {
      function isParticipant(data) {
        return request.auth.uid == data.get('userId', null) ||
               request.auth.uid == data.get('touristId', null) ||
               request.auth.uid == data.get('driverId', null) ||
               request.auth.uid == data.get('vendorId', null) ||
               request.auth.uid == data.get('guideId', null);
      }
      // Ride requests carry a vehicleType; guide and vendor bookings do not
      function isOpenRide(data) {
        return data.status == 'pending' && ('vehicleType' in data) && data.get('driverId', null) == null;
      }
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && !('paymentStatus' in request.resource.data);
      allow read:   if isSignedIn() && (
        isParticipant(resource.data) ||
        isAdmin() ||
        (isDriver() && isOpenRide(resource.data))
      );
      allow update: if isSignedIn() && (isAdmin() || paymentUntouched()) && (
        isParticipant(resource.data) ||
        isAdmin() ||
        // a driver may claim an open ride for themselves (never a guide booking)
        (isDriver() && isOpenRide(resource.data) && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'Confirmed')
      );
    }

    // Vendors collection
    match /vendors/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) &&
        request.resource.data.get('status', 'pending_verification') in ['pending_verification', 'pending'];
      allow update: if isAdmin() || (
        isOwner(uid) &&
        (!changedKeys().hasAny(['status']) || request.resource.data.status in ['pending_verification', 'pending'])
      );
      allow delete: if isAdmin();
    }

    // Vendor subcollections
    match /vendors/{uid}/services/{serviceId} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    match /vendors/{uid}/products/{productId} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // Explicit collection group rule for cross-vendor marketplace queries
    match /{path=**}/services/{serviceId} {
      allow read: if true;
    }

    match /vendors/{uid}/orders/{orderId} {
      allow read: if isOwner(uid) || isAdmin() ||
        (isSignedIn() && resource.data.get('touristId', null) == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if isOwner(uid) || isAdmin();
    }

    // Products listed from the web partner dashboard
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
    }

    // Accommodation rooms and tour packages from the web partner dashboards
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.providerId == request.auth.uid);
    }
    match /tour_packages/{pkgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.providerId == request.auth.uid);
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isOwner(driverId) &&
        request.resource.data.get('status', 'pending_verification') == 'pending_verification';
      // drivers manage their own availability and location, but not their approval status;
      // the only status change they make is sending a rejected application back for review
      allow update: if isAdmin() || (isOwner(driverId) && !changedKeys().hasAny(['rejectionReason']) && (
        !changedKeys().hasAny(['status']) ||
        (resource.data.status == 'rejected' && request.resource.data.status == 'pending_verification')
      ));
      allow delete: if isAdmin();
    }

    // Driver verification documents (file links and the desk's per-document review). Kept apart
    // from drivers/{id}, which every signed-in user can read. The driver uploads; only staff review.
    match /driver_documents/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if isOwner(driverId) && !('review' in request.resource.data);
      allow update: if isAdmin() || (isOwner(driverId) && !changedKeys().hasAny(['review']));
      allow delete: if isAdmin();
    }

    // Orders (global collection)
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.vendorId != request.auth.uid
        && !('paymentStatus' in request.resource.data);
      allow read:   if isSignedIn() && (
        request.auth.uid == resource.data.vendorId ||
        request.auth.uid == resource.data.touristId ||
        isAdmin()
      );
      // The vendor moves the order along; the traveller may only cancel it while it is pending
      allow update: if isSignedIn() && (isAdmin() || paymentUntouched()) && (
        request.auth.uid == resource.data.vendorId ||
        isAdmin() ||
        (request.auth.uid == resource.data.touristId && resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
    }

    // Chats
    match /chats/{chatId} {
      function isChatMember() {
        return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());

      match /messages/{msgId} {
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
        allow read: if isSignedIn() && (isChatMember() || isAdmin());
        // read receipts
        allow update: if isSignedIn() && isChatMember() && changedKeys().hasOnly(['read', 'readAt', 'seen', 'status']);
      }
    }

    // SOS Alerts
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin() || hasRole('guide') || isDriver()
      );
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());

      // Low-bandwidth live-view snapshots: only the traveller and the desk, never drivers or guides
      match /live/{frameId} {
        function alertOwner() {
          return get(/databases/$(database)/documents/sos_alerts/$(alertId)).data.userId == request.auth.uid;
        }
        allow read:  if isSignedIn() && (alertOwner() || isAdmin());
        allow write: if isSignedIn() && alertOwner();
      }
    }

    // Destinations & Events (public read, admin write)
    match /destinations/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /cultural_events/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Notifications (authenticated read, admin write)
    match /notifications/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Itineraries
    match /itineraries/{itineraryId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // One record per generated itinerary (model version, inputs, results, strategy) for the
    // evaluation. Written by the traveller, read by staff, never edited afterwards.
    match /recommendation_records/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Research data (Sprint 4): written by the traveller in their own name after consent,
    // read only by staff for the evaluation, never edited afterwards
    match /usage_events/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /feedback/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
    match /sus_responses/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.susScore is number
        && request.resource.data.susScore >= 0 && request.resource.data.susScore <= 100;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Per-user traveller history
    match /visited_places/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /saved_places/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Tours
    match /tours/{tourId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasRole('guide');
    }

    // Admin-only data
    match /system_config/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /payouts/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_campaigns/{id} {
      allow read, write: if isAdmin();
    }

    // EmergencyLogs
    match /EmergencyLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.touristId || isAdmin());
    }

  }
}
