rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@ceylo.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        request.auth.uid == uid || 
        isAdmin());
    }

    // Bookings (legacy, read by drivers)
    match /bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read:   if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.driverId ||
        request.auth.uid == resource.data.vendorId ||
        request.auth.uid == resource.data.guideId ||
        isAdmin() ||
        ((hasRole('driver') || hasRole('driver_active')) && resource.data.status == 'pending')
      );
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid ||
        hasRole('driver') || hasRole('driver_active') || hasRole('tourist') || hasRole('guide') ||
        isAdmin()
      );
    }

    // Vendors collection
    match /vendors/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && 
        (request.auth.uid == uid || 
         isAdmin());
      allow delete: if request.auth != null && 
        isAdmin();
    }

    // Vendor subcollections
    match /vendors/{uid}/services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.uid == uid || 
         isAdmin());
    }

    match /vendors/{uid}/products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.uid == uid || 
         isAdmin());
    }

    match /{path=**}/products/{productId} {
      allow read: if true;
    }

    // Explicit collection group rule for cross-vendor marketplace queries
    match /{path=**}/services/{serviceId} {
      allow read: if true;
    }

    match /vendors/{uid}/orders/{orderId} {
      allow read: if request.auth != null && 
        (request.auth.uid == uid || 
         isAdmin());
      allow write: if request.auth != null;
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders (global collection)
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && (
        request.auth.uid == resource.data.vendorId ||
        request.auth.uid == resource.data.touristId ||
        isAdmin()
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.vendorId ||
        request.auth.uid == resource.data.touristId ||
        isAdmin()
      );
      allow list: if request.auth != null;
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // SOS Alerts
    match /sos_alerts/{alertId} {
      allow create: if true;
      allow read:   if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        isAdmin() || hasRole('guide') || hasRole('driver')
      );
      allow update: if true; // In production, restrict to resource.data.userId or admins
    }

    // Destinations & Events (public read, admin write)
    match /destinations/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    // Cultural Events (public read, admin write)
    match /cultural_events/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Notifications (authenticated read, admin write)
    match /notifications/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Itineraries
    match /itineraries/{itineraryId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // Tours
    match /tours/{tourId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'guide'];
    }

    // EmergencyLogs
    match /EmergencyLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if true;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.touristId || isAdmin());
    }

  }
}
